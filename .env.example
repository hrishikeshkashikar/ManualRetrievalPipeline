# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# Embedding Model (sentence-transformers)
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5

# Reranker Model (cross-encoder)
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# Storage Paths
# For edge deployments, set PENDRAIVE_DATA_DIR to the mount path of your USB drive (e.g. /media/usb/data)
# to make the application plug-and-play with external indexing. Falls back to ./data if unset.
PENDRAIVE_DATA_DIR=./data
DATA_DIR=./data
CHROMA_PERSIST_DIR=./data/chroma_db
IMAGE_STORE_DIR=./data/images
MANUAL_STORE_DIR=./data/manuals

# Chunking Parameters
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Retrieval Parameters
TOP_K_RETRIEVAL=15
TOP_K_RERANK=5

# Image Processing
MAX_IMAGE_RESOLUTION=1024

# Server
HOST=0.0.0.0
PORT=8000
