# ══════════════════════════════════════════════════════════════════════════
#  .env.example — Environment configuration reference
#
#  LOCAL DEVELOPMENT:
#    cp .env.example .env
#    Edit .env as needed, then: uvicorn app.main:app --reload
#
#  DOCKER (single-container, plug-and-play):
#    Use docker.env instead — it has the correct internal container paths.
#    docker compose --env-file docker.env up -d
#
#  KNOWLEDGE BASE SWITCHING (from the UI):
#    The sidebar has a "Change Data Path" button that opens a modal where
#    you can enter any absolute path to a data folder.
#    - Local: enter an absolute path on your machine (e.g. /Users/you/data2)
#    - Docker: enter a container-side path (e.g. /kb/project-alpha)
#      (you must have added the volume mount in docker-compose.yml first)
#
#  DATA FOLDER STRUCTURE (must remain consistent):
#    <path>/
#      ├── chroma_db/    ← ChromaDB vector store (auto-created)
#      ├── images/       ← Rendered page images (auto-created)
#      └── manuals/      ← Original PDFs (auto-created)
# ══════════════════════════════════════════════════════════════════════════

# ── Ollama ────────────────────────────────────────────────────────────────
# Local dev: http://127.0.0.1:11434
# Docker split-service: http://ollama:11434
# Docker single-container: http://127.0.0.1:11434 (set in docker.env)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Vision model — must be pulled before running (local) or baked in (Docker)
# Options: qwen2.5vl:3b  qwen2.5vl:7b  llama3.2-vision:11b
OLLAMA_VISION_MODEL=qwen2.5vl:3b

# Context window for Ollama calls (edge/8GB: use 4096–8192)
OLLAMA_NUM_CTX=32768

# ── Edge / query-only profile ─────────────────────────────────────────────
# QUERY_ONLY=true disables ingest/delete (edge boxes with a prebuilt data/)
QUERY_ONLY=false
# Set false on 8GB edge to skip loading the cross-encoder (~0.5–1GB RAM)
ENABLE_RERANKER=true
# Images attached to each generate call (edge: 0–1)
MAX_GENERATION_IMAGES=4

# ── HuggingFace Models ────────────────────────────────────────────────────
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# ── HuggingFace Offline Mode (Docker only — baked-in models) ─────────────
# Set to 1 in Docker to prevent any network calls (models are in /opt/hf_models)
# Leave as 0 for local dev (allows automatic model downloads from HuggingFace)
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# Docker-only: path to baked-in HuggingFace model cache (do not change for Docker)
# HF_HOME=/opt/hf_models

# ── Storage Paths (local dev) ─────────────────────────────────────────────
# In Docker these are set to /app/data/* via docker.env.
# The "Change Data Path" UI button overrides these at runtime.
DATA_DIR=./data
CHROMA_PERSIST_DIR=./data/chroma_db
IMAGE_STORE_DIR=./data/images
MANUAL_STORE_DIR=./data/manuals

# ── Chunking ──────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Retrieval ─────────────────────────────────────────────────────────────
TOP_K_RETRIEVAL=15
TOP_K_RERANK=5

# ── Image Processing ──────────────────────────────────────────────────────
MAX_IMAGE_RESOLUTION=1024

# ── Server ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
